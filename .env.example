# ===========================================
# SYNOD - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================================

# ===== Database (PostgreSQL) =====
POSTGRES_USER=synod
POSTGRES_PASSWORD=synod_dev_password
POSTGRES_DB=synod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_CONNECTION=localhost:6379

# ===== JWT Authentication =====
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-security
JWT_ISSUER=synod-api
JWT_AUDIENCE=synod-app
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# ===== Email (Development - MailHog) =====
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM_ADDRESS=noreply@synod.local
EMAIL_FROM_NAME=Synod
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ===== Email (Production - Gmail) =====
# Uncomment and fill these for production
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:5048/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Backend =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ===== Monitoring (Production) =====
# SENTRY_DSN=your-sentry-dsn
